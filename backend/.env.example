# Flashion E-commerce Platform Environment Variables

# =============================================================================
# ENVIRONMENT
# =============================================================================
# development or production.
# development: a random JWT_SECRET is generated if none is set and uvicorn
# auto-reloads on code changes.
# production: the backend refuses to start without a real JWT_SECRET.
ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local MongoDB, or your MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=flashion

# =============================================================================
# JWT SECURITY
# =============================================================================
# Secret used to sign login tokens. Required when ENV=production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# (SECRET_KEY is still accepted as a fallback name.)
JWT_SECRET=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# SERVER CONFIGURATION (Optional - defaults work fine)
# =============================================================================
# HOST=0.0.0.0
# PORT=8000
# DEBUG=True

# =============================================================================
# CORS SETTINGS (Optional - defaults work fine)
# =============================================================================
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# FRONTEND CONFIGURATION (Optional - for local development)
# =============================================================================
# REACT_APP_API_URL=http://localhost:8000/api
# REACT_APP_ENVIRONMENT=development
# Flashion E-commerce Platform Environment Variables

# =============================================================================
# ENVIRONMENT
# =============================================================================
# development or production.
# production: the backend refuses to start without a real JWT_SECRET and
# uvicorn runs without auto-reload.
# development: a random JWT_SECRET is generated if none is set and uvicorn
# auto-reloads on code changes.
ENV=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/flashion?retryWrites=true&w=majority
DATABASE_NAME=flashion

# =============================================================================
# JWT SECURITY
# =============================================================================
# Secret used to sign login tokens. Required for every ENV value except
# development/dev (unknown values such as "staging" also need a real secret).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# (SECRET_KEY is still accepted as a fallback name.)
JWT_SECRET=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# ADMIN ACCOUNT (optional)
# =============================================================================
# On startup, backend/startup.sh creates this admin user if it does not exist.
# Leave empty (or keep the placeholder) to skip admin creation.
# The password is never printed to the logs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Update with your domain for production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Update with your domain for production
REACT_APP_API_URL=http://localhost:8000/api

# Optional bank transfer details shown in the shop (used at frontend build time).
# Leave empty to show "payment details are provided after ordering, please
# contact the shop" instead. Never commit real account details.
REACT_APP_BANK_NAME=
REACT_APP_BANK_ACCOUNT_NUMBER=
REACT_APP_BANK_ACCOUNT_HOLDER=
REACT_APP_BANK_QR_URL=

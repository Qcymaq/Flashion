# Copy this file to .env.local (gitignored) and fill in your own values.
# Create React App reads these at build time, so rebuild after changing them.

# API base URL for the React frontend
REACT_APP_API_URL=http://localhost:8000/api

# Bank transfer details shown at checkout and in the membership upgrade dialog.
# Leave them empty to show "payment details are provided after ordering,
# please contact the shop" instead. Never commit real account details.
REACT_APP_BANK_NAME=
REACT_APP_BANK_ACCOUNT_NUMBER=
REACT_APP_BANK_ACCOUNT_HOLDER=
# Public URL of a payment QR code image (optional), e.g. https://example.com/payment-qr.png
REACT_APP_BANK_QR_URL=
